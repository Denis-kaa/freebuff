# Realtor OS secrets
# Copy to .env and fill real values.

# PII encryption key (32 bytes hex for Fernet)
PII_ENCRYPTION_KEY=

# Local LLM endpoint
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b

# Yandex Disk OAuth token (optional)
YANDEX_DISK_TOKEN=

# Email settings (optional)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=

# Logging
LOG_LEVEL=INFO
