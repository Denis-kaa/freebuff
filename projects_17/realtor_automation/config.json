{
  "app": {
    "name": "realtor_automation",
    "version": "0.1.0",
    "log_level": "INFO",
    "quiet": false
  ***REMOVED***,
  "paths": {
    "data": "data",
    "knowledge": "data/knowledge",
    "documents": "data/documents",
    "logs": "logs",
    "state_file": "data/project_state.json"
