# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather. Обязателен для запуска бота.
BOT_TOKEN=

# Список Telegram ID админов (через запятую). Получают доступ к /admin.
ADMIN_IDS=

# Telegram ID продавца по умолчанию (опционально, для первичной настройки).
DEFAULT_SELLER_ID=

# ─── База данных ────────────────────────────────────────────────────────────
# Путь к SQLite-файлу. Относительный путь — от корня проекта.
DATABASE_PATH=data/market.sqlite

# ─── Платёжный провайдер ─────────────────────────────────────────────────────
# Поддерживается: "mock" (dev/demo) и "telegram_stars" (прод).
PAYMENT_PROVIDER=mock

# Для telegram_stars — токен провайдера от @BotFather (Payments → Bot → Provider token).
# Документация: https://core.telegram.org/bots/payments
PAYMENT_PROVIDER_TOKEN=

# TTL оплаченной сессии (в секундах) — после истечения заказ автоматически
# отменяется и зарезервированные ключи возвращаются в сток.
PAYMENT_TTL_SECONDS=900

# ─── Опционально ────────────────────────────────────────────────────────────
# Уровень логирования: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
