# settings.env — переменные окружения lead_aggregator (Фаза 4 Deploy)
# Создан из settings.env.example. Загружается автоматически через Config.load_config().
# ЗАПОЛНИ LA_TG_BOT_TOKEN + LA_TG_CHAT_ID для реальной доставки лидов в TG.

# Период опроса источников, сек (24/7 цикл)
LA_POLL_INTERVAL=600

# Порог отсечки lead_score 0-100
LA_SCORE_THRESHOLD=50

# Доставка лидов в Telegram (пусто = логирование, без отправки)
LA_TG_BOT_TOKEN=
LA_TG_CHAT_ID=

# Первый адаптер: Kwork (рекомендация PHASE2 §8)
LA_KWORK_ENABLED=1
LA_KWORK_FEED=https://kwork.ru/projects

# TG-каналы с заказами (через t.me/s/ web-preview, без авторизации)
LA_TG_CHANNELS=freelance_tg,proger_orders
